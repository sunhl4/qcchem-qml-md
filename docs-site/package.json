{
  "name": "qchem-stack-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs --open",
    "sync:configs-table": "node scripts/sync-configs-table.mjs",
    "check:configs-table": "node scripts/sync-configs-table.mjs && node scripts/check-configs-table-diff.mjs",
    "docs:build": "npm run sync:configs-table && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "fix-links": "node scripts/fix-internal-links.mjs",
    "scaffold:mirror": "node scripts/scaffold-mirror.mjs",
    "check:mirror": "node scripts/check-mirror-coverage.mjs",
    "check:node-backlog": "node scripts/check-inquanto-node-backlog.mjs",
    "verify:inquanto": "npm run check:mirror && npm run check:node-backlog",
    "report:inquanto-appendix": "node scripts/export-inquanto-report-appendix.mjs",
    "report:inquanto-backlog": "node scripts/export-inquanto-node-backlog.mjs"
  },
  "devDependencies": {
    "js-yaml": "^4.1.1",
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "^11.14.0",
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.13"
  }
}
