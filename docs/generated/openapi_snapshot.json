            "additionalProperties": true,
            "description": "Validated QMEFDataset JSON",
            "title": "Qmef",
            "type": "object"
          }
        },
        "required": [
          "qmef"
        ],
        "title": "QMEFTrainerStubFitBody",
        "type": "object"
      },
      "QMEFValidateBody": {
        "properties": {
          "qmef": {
            "additionalProperties": true,
            "description": "JSON object matching QMEFDataset (frames + optional provenance_yaml)",
            "title": "Qmef",
            "type": "object"
          }
        },
        "required": [
          "qmef"
        ],
        "title": "QMEFValidateBody",
        "type": "object"
      },
      "RunRequest": {
        "properties": {
          "config_base_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional base directory for resolving relative geometry_file/precomputed paths in experiment_yaml",
            "title": "Config Base Dir"
          },
          "experiment_yaml": {
            "description": "Full experiment YAML (same as CLI configs)",
            "title": "Experiment Yaml",
            "type": "string"
          },
          "job_db_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "SQLite path for queued jobs; default from QCHEM_JOB_DB or temp",
            "title": "Job Db Path"
          },
          "project_slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional Nexus/organization project slug stored in meta (api_project_slug); pairs with workspace for listing",
            "title": "Project Slug"
          },
          "sync": {
            "default": false,
            "description": "If true, run in-process and return full_pipeline_job_result_v1 (JSON-safe slim dict, same as async DONE payload)",
            "title": "Sync",
            "type": "boolean"
          },
          "workspace_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional Nexus-style project/workspace string stored in job meta (api_workspace_label)",
            "title": "Workspace Label"
          }
        },
        "required": [
          "experiment_yaml"
        ],
        "title": "RunRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "YamlPreviewBody": {
        "properties": {
          "experiment_yaml": {
            "description": "YAML to validate; returns computable list without running chemistry",
            "title": "Experiment Yaml",
            "type": "string"
          },
          "include_computables_rich": {
            "default": false,
            "description": "Optional parallel field: adds computables_rich (schema computables_rich_v1) without removing computable_abstract",
            "title": "Include Computables Rich",
            "type": "boolean"
          }
        },
        "required": [
          "experiment_yaml"
        ],
        "title": "YamlPreviewBody",
        "type": "object"
      }
    }
  },
