{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "QMEFTrainerStubFitBody": {
        "properties": {
          "hyperparams": {
            "additionalProperties": true,
            "description": "Forwarded into StubTorchMLIPTrainer.fit meta",
            "title": "Hyperparams",
            "type": "object"
          },
