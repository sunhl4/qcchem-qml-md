# Copy to .env and fill in before `docker compose up` (production / local stack).
# Never commit real secrets.

# Required — protocol blob HMAC (generate: python -c "import secrets; print(secrets.token_hex(32))")
QCHEM_PROTOCOL_HMAC_KEY=replace-with-random-hex-secret

# Required for qchem-api — HTTP API key
QCHEM_STACK_API_KEY=replace-with-random-api-key

# Optional — enforce API key at startup (default 1 in docker-compose)
QCHEM_STACK_REQUIRE_API_KEY=1

# Optional — Postgres job store (default in docker-compose points at postgres service)
# QCHEM_JOB_DATABASE_URL=postgresql://qchem:qchem@postgres:5432/qchem_jobs

# Optional — trusted config root for path sandbox
# QCHEM_STACK_CONFIG_BASE_DIR=/configs
