[importlinter]
root_packages =
    qchem_stack

[importlinter:contract:chem-no-orchestration]
name = chem must not import orchestration
type = forbidden
source_modules =
    qchem_stack.chem
forbidden_modules =
    qchem_stack.orchestration

[importlinter:contract:quantum-no-orchestration]
name = quantum must not import orchestration
type = forbidden
source_modules =
    qchem_stack.quantum
forbidden_modules =
    qchem_stack.orchestration

[importlinter:contract:protocols-no-orchestration]
name = protocols must not import orchestration
type = forbidden
source_modules =
    qchem_stack.protocols
forbidden_modules =
    qchem_stack.orchestration

[importlinter:contract:integrations-no-orchestration]
name = integrations must not import orchestration at module level
type = forbidden
source_modules =
    qchem_stack.integrations
forbidden_modules =
    qchem_stack.orchestration

[importlinter:contract:chem-no-jobs]
name = chem must not import jobs
type = forbidden
source_modules =
    qchem_stack.chem
forbidden_modules =
    qchem_stack.jobs

[importlinter:contract:quantum-no-jobs]
name = quantum must not import jobs
type = forbidden
source_modules =
    qchem_stack.quantum
forbidden_modules =
    qchem_stack.jobs

[importlinter:contract:orchestration-no-api]
name = orchestration must not import api
type = forbidden
source_modules =
    qchem_stack.orchestration
forbidden_modules =
    qchem_stack.api

[importlinter:contract:md-bridge-no-orchestration]
name = md_bridge must not import orchestration at module level
type = forbidden
source_modules =
    qchem_stack.md_bridge
forbidden_modules =
    qchem_stack.orchestration
