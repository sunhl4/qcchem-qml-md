[importlinter]
root_packages =
    qchem_stack

[importlinter:contract:chem-no-orchestration]
name = chem must not import orchestration
type = forbidden
source_modules =
    qchem_stack.chem
forbidden_modules =
    qchem_stack.orchestration

[importlinter:contract:quantum-no-orchestration]
name = quantum must not import orchestration
type = forbidden
source_modules =
    qchem_stack.quantum
forbidden_modules =
    qchem_stack.orchestration

[importlinter:contract:protocols-no-orchestration]
name = protocols must not import orchestration
type = forbidden
source_modules =
    qchem_stack.protocols
forbidden_modules =
    qchem_stack.orchestration

[importlinter:contract:integrations-no-orchestration]
name = integrations must not import orchestration at module level
type = forbidden
source_modules =
    qchem_stack.integrations
forbidden_modules =
    qchem_stack.orchestration

[importlinter:contract:chem-no-jobs]
name = chem must not import jobs
type = forbidden
source_modules =
    qchem_stack.chem
forbidden_modules =
    qchem_stack.jobs

[importlinter:contract:quantum-no-jobs]
name = quantum must not import jobs
type = forbidden
source_modules =
    qchem_stack.quantum
forbidden_modules =
    qchem_stack.jobs

[importlinter:contract:orchestration-no-api]
name = orchestration must not import api
type = forbidden
source_modules =
    qchem_stack.orchestration
forbidden_modules =
    qchem_stack.api

[importlinter:contract:md-bridge-no-orchestration]
name = md_bridge must not import orchestration at module level
type = forbidden
source_modules =
    qchem_stack.md_bridge
forbidden_modules =
    qchem_stack.orchestration

# Layered architecture (higher layers may import lower layers; not vice versa).
# Order is HIGHER -> LOWER. Modules on the same line separated by `:` are peers
# (may import each other). The middle packages form a strongly-connected
# mutual-dependency cluster (e.g. protocols<->backends, jobs<->orchestration,
# chem->repro->protocols, config<->chem/backends), so they are declared as ONE
# peer layer; a finer linear split is infeasible without refactoring the
# import cycles. This contract still enforces the meaningful outer boundaries:
# api/sdk are not imported by the middle; contracts/exceptions stay leaf.
[importlinter:contract:layered-architecture]
name = Layered architecture (api/sdk > middle cluster > contracts/exceptions)
type = layers
layers =
    qchem_stack.api : qchem_stack.sdk
    qchem_stack.repro : qchem_stack.protocols : qchem_stack.jobs : qchem_stack.orchestration : qchem_stack.integrations : qchem_stack.md_bridge : qchem_stack.qpe_qec_demo : qchem_stack.tensornet : qchem_stack.chem : qchem_stack.quantum : qchem_stack.backends : qchem_stack.mitigation : qchem_stack.config
    qchem_stack.contracts : qchem_stack.exceptions
