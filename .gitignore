# virtualenv
.venv/
.venv-*/
venv/
.venv-wsl/
env/

# optional Psi4 micromamba prefix (see scripts/setup_psi4_micromamba.sh)
.micromamba/
bin/micromamba

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
*.egg-info/
*.egg

# test / lint / type
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# docusaurus-site
docusaurus-site/node_modules/
docusaurus-site/build/
docusaurus-site/.docusaurus/

# local / secrets
.env
.env.*
!.env.example

# SQLite / local jobs (if created at repo root)
*.db
timer.dat

# Run outputs (local only; see results/README.md)
results/*
!results/README.md
artifacts/

# Root-level artifacts (should not be committed)
*.pptx
psi.*.clean
deck_build.*
package-lock.json

# Root-level transient artifacts (agent session dumps / archives — keep out of repo)
/qwen*.test.md
/yaozheng/
/yaozheng.tar.gz
/*-test.md
/*_test.md
/*.tar.gz

# Agent / session logs (transient)
tasks_*.csv
.ferrmion.log

# Jupyter
.ipynb_checkpoints/

# Example runs (keep .gitkeep + README)
examples/artifacts/**
!examples/artifacts/.gitkeep
!examples/artifacts/README.md

# Cursor recovery / agent transcripts (local only)
/.cursor_recover/
