#!/usr/bin/env bash
set -euo pipefail

# Project-local hard-pinned Python environment for this workspace.
VENV_PYTHON="/home/sunhl/projects/qchem_qml_md/.venv/bin/python"

if [[ ! -x "$VENV_PYTHON" ]]; then
  echo "error: pinned venv python not found: $VENV_PYTHON" >&2
  echo "hint: create/repair the venv at /home/sunhl/projects/qchem_qml_md/.venv" >&2
  exit 1
fi

if [[ $# -eq 0 ]]; then
  echo "usage: ./scripts/venv-run <command> [args...]" >&2
  echo "example: ./scripts/venv-run pytest tests -q --tb=short" >&2
  exit 2
fi

VENV_BIN="$(dirname "$VENV_PYTHON")"
export PATH="$VENV_BIN:$PATH"

exec "$@"
