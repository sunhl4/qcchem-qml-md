#!/usr/bin/env bash
set -euo pipefail

# Default Python for this workspace. Override anytime, e.g.:
#   export QCHEM_STACK_PYTHON=/path/to/python
#   ./scripts/venv-run pytest tests -q
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_VENV_PYTHON="$ROOT/.venv/bin/python"

if [[ -n "${QCHEM_STACK_PYTHON:-}" ]]; then
  default_python="$QCHEM_STACK_PYTHON"
elif [[ -x "$REPO_VENV_PYTHON" ]]; then
  default_python="$REPO_VENV_PYTHON"
else
  default_python="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || echo "")"
fi

VENV_PYTHON="$default_python"

if [[ ! -x "$VENV_PYTHON" ]]; then
  echo "error: python interpreter not found or not executable: $VENV_PYTHON" >&2
  echo "hint: conda activate base, or export QCHEM_STACK_PYTHON=/path/to/python" >&2
  exit 1
fi

if [[ $# -eq 0 ]]; then
  echo "usage: ./scripts/venv-run <command> [args...]" >&2
  echo "example: ./scripts/venv-run pytest tests -q --tb=short" >&2
  exit 2
fi

VENV_BIN="$(dirname "$VENV_PYTHON")"
export PATH="$VENV_BIN:$PATH"

exec "$@"
